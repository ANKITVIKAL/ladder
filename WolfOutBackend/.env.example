# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of allowed CORS origins.
# Use * to allow any origin (fine for local dev / demo).
CORS_ORIGIN=*

# JWT
# Generate a strong secret, e.g:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Database file location (relative to backend root)
DB_PATH=data/wolfout.db

# Path to the problems CSV used for seeding
PROBLEMS_CSV=data/Final_database_to_upload.csv

# Codeforces API base (rarely needs changing)
CODEFORCES_API=https://codeforces.com/api
