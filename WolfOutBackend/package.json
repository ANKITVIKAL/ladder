  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/db/seed.js"
  },
  "keywords": [
    "codeforces",
    "ladder",
    "competitive-programming",
    "express",
    "api"
  ],
